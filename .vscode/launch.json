{
  "version": "0.2.0",
  "configurations": [
    {
      // PREDVOLENÁ (lekcie 01–04): spustí súbor, ktorý máš práve otvorený.
      // console: integratedTerminal je KĽÚČOVÉ — bez neho nefunguje input().
      "name": "Spusti otvorený súbor",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}"
    },
    {
      // Použi až od LEKCIE 05, keď vytvoríš hra/__main__.py.
      // Skôr skončí hláškou "'hra' is a package and cannot be directly executed".
      "name": "Spusti hru (od lekcie 05)",
      "type": "debugpy",
      "request": "launch",
      "module": "hra",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}"
    }
  ]
}
